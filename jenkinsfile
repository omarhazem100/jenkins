pipeline {
    agent none

    stages {
        stage('Parallel Test') {
            parallel {

                stage('Agent 1') {
                    agent { label 'agent1' }
                    steps {
                         sh 'sudo dnf install git -y'
                         sh'git ls-remote https://github.com/omarhazem100/jenkins.git'
                        echo 'Hello from Agent 1 from SCM'
                        sh 'ip addr'
                    }
                }

                stage('Agent 2') {
                    agent { label 'agent2' }
                    steps {
                        sh 'sudo dnf install git -y'
                        sh'git ls-remote https://github.com/omarhazem100/jenkins.git'
                        echo 'Hello from Agent 2 from SCM'
                        sh 'ip addr'
                    }
                }
            }
        }
    }
}
