pipeline {
    agent none

    stages {
        stage('Parallel Test') {
            parallel {

                stage('Agent 1') {
                    agent { label 'agent1' }
                    steps {
                        echo 'Hello from Agent 1 from SCM'
                        sh 'ip addr'
                    }
                }

                stage('Agent 2') {
                    agent { label 'agent2' }
                    steps {
                        echo 'Hello from Agent 2 from SCM'
                        sh 'ip addr'
                    }
                }
            }
        }
    }
}
